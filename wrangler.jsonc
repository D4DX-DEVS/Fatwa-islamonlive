{
  // Only used by the `npm run cf` / `npm run db:seed:remote` commands to find the D1 database; the site itself runs on Vercel.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fatwa",
  "d1_databases": [{ "binding": "DB", "database_name": "fatwa", "database_id": "e2aaf3e0-b88a-4529-a3fc-64d3a62f0096" }]
}
