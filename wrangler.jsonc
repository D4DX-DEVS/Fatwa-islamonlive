{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fatwa",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "fatwa" }],
  // database_id is filled in by `wrangler d1 create fatwa` (see DEPLOY.md)
  "d1_databases": [{ "binding": "DB", "database_name": "fatwa" }],
  "vars": { "SITE_URL": "https://fatwa.islamonlive.in" }
}
