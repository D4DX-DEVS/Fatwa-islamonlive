{
  "name": "fatwa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && node scripts/strip-env.mjs && node --env-file=.env node_modules/@opennextjs/cloudflare/dist/cli/index.js deploy",
    "db:seed:remote": "node --env-file=.env node_modules/wrangler/bin/wrangler.js d1 execute DB --remote --file d1/seed.sql",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf": "node --env-file=.env node_modules/wrangler/bin/wrangler.js"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.14",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.153.0"
  }
}
